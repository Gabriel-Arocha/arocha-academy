---
// Standalone password gate — no BaseLayout so there's no redirect loop.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Arocha Academy — Private Preview</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,500&family=Nunito+Sans:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --cream:     #FBF6EF;
        --ink:       #3B2D25;
        --ink-soft:  #6E5C50;
        --clay:      #C2714F;
        --clay-dark: #A85B3C;
        --gold:      #C6A15B;
        --shadow:    rgba(59, 45, 37, 0.12);
        --serif: 'Playfair Display', Georgia, serif;
        --sans:  'Nunito Sans', system-ui, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: var(--sans);
        background: var(--cream);
        color: var(--ink);
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      .card {
        background: #fff;
        border-radius: 1.25rem;
        box-shadow: 0 8px 40px var(--shadow);
        padding: 3rem 2.5rem;
        width: 100%;
        max-width: 420px;
        text-align: center;
      }
      .logo {
        font-family: var(--serif);
        font-size: 1.6rem;
        color: var(--clay);
        margin-bottom: 0.25rem;
        letter-spacing: 0.01em;
      }
      .subtitle {
        font-size: 0.875rem;
        color: var(--ink-soft);
        margin-bottom: 2.25rem;
      }
      label {
        display: block;
        text-align: left;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 0.5rem;
      }
      input[type="password"] {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1.5px solid #ddd;
        border-radius: 0.6rem;
        font-family: var(--sans);
        font-size: 1rem;
        color: var(--ink);
        background: #fafafa;
        outline: none;
        transition: border-color 0.2s;
      }
      input[type="password"]:focus { border-color: var(--clay); background: #fff; }
      .error {
        display: none;
        margin-top: 0.6rem;
        font-size: 0.85rem;
        color: #c0392b;
        text-align: left;
      }
      .error.visible { display: block; }
      button {
        margin-top: 1.5rem;
        width: 100%;
        padding: 0.85rem;
        background: var(--clay);
        color: #fff;
        border: none;
        border-radius: 0.6rem;
        font-family: var(--sans);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      button:hover { background: var(--clay-dark); }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="logo">Arocha Academy</p>
      <p class="subtitle">This site is password protected.</p>
      <form id="gate" novalidate>
        <label for="pw">Password</label>
        <input id="pw" type="password" autocomplete="current-password" autofocus />
        <p id="err" class="error">Incorrect password. Please try again.</p>
        <button type="submit">Enter</button>
      </form>
    </div>

    <script is:inline>
      document.getElementById('gate').addEventListener('submit', function (e) {
        e.preventDefault();
        var val = document.getElementById('pw').value;
        var err = document.getElementById('err');
        if (val === 'aacademy2026!') {
          localStorage.setItem('aa_auth', 'granted');
          var params = new URLSearchParams(window.location.search);
          var next = params.get('next');
          window.location.replace(next && next.startsWith('/') ? next : '/en/');
        } else {
          err.classList.add('visible');
          document.getElementById('pw').value = '';
          document.getElementById('pw').focus();
        }
      });
    </script>
  </body>
</html>
