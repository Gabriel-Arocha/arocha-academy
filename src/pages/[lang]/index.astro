---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Story from '../../components/Story.astro';
import Projects from '../../components/Projects.astro';
import Courses from '../../components/Courses.astro';
import BlogTalks from '../../components/BlogTalks.astro';
import Contact from '../../components/Contact.astro';
import type { Lang } from '../../i18n/ui';
import { otherLang, langFromBlogId } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: Lang };
const entry = await getEntry('site', lang);
const site = entry!.data;

// Latest posts for this language, newest first, for the homepage section.
const posts = (await getCollection('blog'))
  .filter((post) => langFromBlogId(post.id) === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const altLangUrl = `/${otherLang(lang)}/`;
---

<BaseLayout lang={lang} site={site} altLangUrl={altLangUrl}>
  <Hero hero={site.hero} lang={lang} />
  <Story story={site.story} />
  <Projects projects={site.projects} />
  <Courses courses={site.courses} />
  <BlogTalks blog={site.blog} posts={posts} lang={lang} />
  <Contact contact={site.contact} />
</BaseLayout>
