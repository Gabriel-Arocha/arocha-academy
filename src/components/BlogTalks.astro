---
import type { Lang } from '../i18n/ui';
import { useTranslations, slugFromBlogId } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  blog: { eyebrow: string; heading: string; readMore: string };
  posts: CollectionEntry<'blog'>[];
  lang: Lang;
}

const { blog, posts, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="block alt" id="blog">
  <div class="wrap">
    <div class="section-head">
      {blog.eyebrow && <span class="eyebrow">{blog.eyebrow}</span>}
      {blog.heading && <h2>{blog.heading}</h2>}
      <div class="divider"></div>
    </div>

    {
      posts.length > 0 ? (
        <div class="blog-list">
          {posts.map((post) => {
            const slug = slugFromBlogId(post.id);
            const isTalk = post.data.tag === 'talk';
            const tagLabel = isTalk ? t('tag.talk') : t('tag.article');
            return (
              <a class="blog-item" href={`/${lang}/blog/${slug}`}>
                <span class:list={['tag', { talk: isTalk }]}>{tagLabel}</span>
                <div class="blog-item-main">
                  <h3>{post.data.title}</h3>
                  {post.data.summary && <p>{post.data.summary}</p>}
                </div>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            );
          })}
        </div>
      ) : (
        <p style="text-align:center;color:var(--ink-soft)">{t('blog.empty')}</p>
      )
    }
  </div>
</section>
