---
import type { Lang } from '../i18n/ui';

interface Props {
  hero: { eyebrow: string; title: string; tagline: string; cta: string };
  lang: Lang;
}

const { hero, lang } = Astro.props;
const contactHref = `/${lang}/#contact`;
---

<section class="hero" id="top">
  <svg class="leaf one" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2C7 7 4 11 4 15a8 8 0 0016 0c0-4-3-8-8-13z" />
  </svg>
  <svg class="leaf two" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2C7 7 4 11 4 15a8 8 0 0016 0c0-4-3-8-8-13z" />
  </svg>
  <div class="wrap">
    {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
    <h1>{hero.title}</h1>
    {hero.tagline && <p class="tagline">{hero.tagline}</p>}
    {hero.cta && <a href={contactHref} class="btn">{hero.cta}</a>}
  </div>
</section>
